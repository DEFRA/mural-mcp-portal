# Without a session cookie password the app will fail to start. You can generate a password using the following command:
# openssl rand -base64 32
SESSION_COOKIE_PASSWORD=

# Mural MCP service configuration
MURAL_MCP_URL=http://localhost:8085

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
ENTRA_REDIRECT_HOST=http://localhost:3000

# Feature flags (both default to false)
# Self-service board access requests and the approvals pages. When false, board
# access is governed solely by the MCP server's env allow list.
SELF_SERVICE_ACCESS_ENABLED=false
# Data handling form upload via CDP Uploader. Only meaningful when
# SELF_SERVICE_ACCESS_ENABLED=true.
DATA_HANDLING_UPLOAD_ENABLED=false
