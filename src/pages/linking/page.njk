{% extends "common/layouts/content.njk" %}
{% from "common/components/notification.njk" import appNotification %}
{% from "common/components/check-steps.njk" import defraCheckSteps %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set linkingMessages = {
  'success': { type: 'success', text: 'Connected successfully!' },
  'validation_failed': { type: 'error', text: 'Security validation failed - please try again' },
  'failed': { type: 'error', text: 'Connection failed - please try again' },
  'cancelled': { type: 'warning', text: 'Connection cancelled - you can try again later' }
} %}

{% set title = 'Your Mural connection' %}
{% set caption = 'Your account' %}
{% set description = 'Connecting lets the MCP server read Mural boards using your own Mural sign-in. The portal itself never reads your boards.' %}
{% set breadcrumbItems = [
  { text: "Home", href: "/dashboard" },
  { text: "Your Mural connection" }
] %}
{% set notesHeading = 'About your connection' %}
{% set notes = [
  {
    title: "Who reads my boards?",
    html: 'The <strong>MCP server</strong> does, using the connection you set up here. This portal never reads a Mural board - it is only how you connect your account, request boards and track approvals.'
  },
  {
    title: "What is this connection for?",
    html: 'It lets the MCP server read Mural boards on your behalf when an AI agent asks it to. Nothing is shared beyond what your own Mural account can already reach.'
  },
  {
    title: "What happens when I connect?",
    html: 'You are taken to Mural to sign in and approve access for the MCP server, then brought straight back here. You never enter your Mural password into the portal.'
  },
  {
    title: "Why do I need my own Mural account?",
    html: 'So that access follows the person, not the MCP server. Approving a board opens it to everyone who already has access to it in Mural - it never grants Mural access to anyone who does not.'
  }
] %}

{% block beforeHeading %}
  {# The flash from a just-completed OAuth round-trip, and the reason a gated
     route sent the user here. Both are things that have just happened, which
     is what a notification banner is for. #}
  {{ appNotification(linkingMessages[message]) }}

  {% if requiredReason %}
    {{ appNotification({
      type: "warning",
      text: "You need to connect your Mural account to " + requiredReason + "."
    }) }}
  {% endif %}
{% endblock %}

{% block pageBody %}
  <h2 class="govuk-heading-m">Connection status</h2>

  {# Status only - the single action lives in the button below, so the page
     does not offer the same link twice. #}
  {{ defraCheckSteps({ steps: steps }) }}

  {% if statusError %}
    <p class="govuk-body govuk-!-margin-top-6">
      <a class="govuk-link" href="/account/mural-linking">Check your connection again</a>
    </p>
  {% elif needsReconnect and reconnectUrl %}
    {# Linked, but Mural refused the stored token - so the page offers a way
       out rather than leaving a red step with nothing to do about it. #}
    {{ govukButton({
      text: "Reconnect Mural account",
      href: reconnectUrl,
      classes: "govuk-!-margin-top-6"
    }) }}
  {% elif linkingUrl %}
    {{ govukButton({
      text: "Connect Mural account",
      href: linkingUrl,
      classes: "govuk-!-margin-top-6"
    }) }}
  {% endif %}
{% endblock %}
